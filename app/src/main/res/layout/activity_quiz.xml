<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_input"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_logout"
                android:rotation="180"
                app:tint="@color/text_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Kuis Pengetahuan Nusantara"
                android:textColor="@color/gold_accent"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stats Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvQuestionProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Soal 1 dari 5"
                android:textColor="@color/purple_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Reward Earned -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Koin"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tvEarnedCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="+0 LP"
                android:textColor="@color/color_success"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Question Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvQuestionTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="BUDAYA NUSANTARA"
                android:textColor="@color/gold_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="Rumah adat yang memiliki atap meruncing menyerupai tanduk kerbau bernama Rumah Gadang berasal dari daerah?"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Option Buttons -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOptionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:padding="16dp"
                android:text="A. Sumatera Barat (Minangkabau)"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOptionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:padding="16dp"
                android:text="B. Jawa Tengah"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOptionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:padding="16dp"
                android:text="C. Sulawesi Selatan"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOptionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:padding="16dp"
                android:text="D. Kalimantan Timur"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <!-- Explanation / Result Box -->
            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/color_success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Next Question Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNextQuestion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button"
                android:text="PERTANYAAN BERIKUTNYA ➔"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
