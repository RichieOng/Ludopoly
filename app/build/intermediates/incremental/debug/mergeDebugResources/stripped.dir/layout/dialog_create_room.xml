<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Buat Room Baru"
        android:textColor="@color/gold_accent"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Buat arena bermain LudoPoly bersama teman Anda."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Room Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDialogRoomName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:hint="Nama Room (misal: Mabar Nusantara)"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/purple_primary"
        app:hintTextColor="@color/purple_light">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Short Room ID Card (Auto Generated) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KODE ROOM OTOMATIS (SINGKAT)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGeneratedRoomId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.1"
                android:text="LP492"
                android:textColor="@color/gold_accent"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegenerateId"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="12dp"
            android:text="🔄 ACAK"
            android:textAllCaps="true"
            android:textColor="@color/purple_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Username Host Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDialogHostUsername"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="Username Anda (Host)"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/purple_primary"
        app:hintTextColor="@color/purple_light">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogHostUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitCreateRoom"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button"
        android:text="BUAT &amp; MASUK ROOM"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
